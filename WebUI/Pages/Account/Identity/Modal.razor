@namespace CustomComponents.Modals

<div class="modal-overlay @(IsOpen ? "show" : "hide")" @onclick="CloseModal">
    <div class="modal-dialog" style="@(CustomStyle ?? "max-width: 500px;")" @onclick:stopPropagation>
        <div class="modal-content border @BorderClass">
            @if (!string.IsNullOrEmpty(HeaderText))
            {
                <div class="modal-header">
                    <h5 class="modal-title">@HeaderText</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal">×</button>
                </div>
            }
            <div class="modal-body">
                @Body
            </div>
            <div class="modal-footer">
                @Footer
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? HeaderText { get; set; }
    [Parameter] public string? BorderClass { get; set; } = "border-success";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? CustomStyle { get; set; }

    private void CloseModal()
    {
        IsOpen = false;
        OnClose.InvokeAsync(null);
    }
}
